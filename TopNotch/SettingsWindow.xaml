<Window x:Class="TopNotch.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TopNotch"
        Title="TopNotch Settings"
        Icon="/Sprites/tray.ico"
        Width="760" Height="540"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="#1E1E1E"
        FontFamily="{StaticResource AppFont}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <Style x:Key="NavRow" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" CornerRadius="6" Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#3A3A3C" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#0A84FF" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FormatCard" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Background="Transparent">
                            <Border x:Name="Card" Width="168" Height="86" CornerRadius="9"
                                    Background="#2C2C2E" BorderBrush="#3A3A3C" BorderThickness="2">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock x:Name="Caption" Text="{TemplateBinding Tag}"
                                       FontSize="11" Margin="0,7,0,0"
                                       HorizontalAlignment="Center" Foreground="#98989D" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="#3A3A3C" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="#0A84FF" />
                                <Setter TargetName="Caption" Property="Foreground" Value="#0A84FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#98989D" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fill" Background="#0A84FF" CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fill" Property="Background" Value="#2A95FF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Fill" Property="Background" Value="#0071E3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QuietButton" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fill" Background="#3A3A3C" CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fill" Property="Background" Value="#48484A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Fill" Property="Background" Value="#2C2C2E" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#8E8E93" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fill" Background="#FF453A" CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fill" Property="Background" Value="#FF6961" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Fill" Property="Background" Value="#D70015" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Fill" Property="Background" Value="#5A2A28" />
                                <Setter Property="Foreground" Value="#C7A3A0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Switch" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent">
                            <Border Width="40" Height="24" CornerRadius="12" Background="#48484A" />
                            <Border x:Name="Fill" Width="40" Height="24" CornerRadius="12"
                                    Background="#0A84FF" Opacity="0" />
                            <Border x:Name="Knob" Width="18" Height="18" CornerRadius="9"
                                    Background="#FFFFFF"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="KnobShift" X="-8" />
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="KnobShift"
                                                             Storyboard.TargetProperty="X" To="8"
                                                             Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="Fill"
                                                             Storyboard.TargetProperty="Opacity" To="1"
                                                             Duration="0:0:0.16" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="KnobShift"
                                                             Storyboard.TargetProperty="X" To="-8"
                                                             Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="Fill"
                                                             Storyboard.TargetProperty="Opacity" To="0"
                                                             Duration="0:0:0.16" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track"
                                   Orientation="Vertical"
                                   IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                                  Focusable="False"
                                                  IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>

                                <Track.Thumb>
                                    <Thumb MinHeight="28">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border x:Name="Bar"
                                                        Width="6"
                                                        Margin="0,2"
                                                        HorizontalAlignment="Center"
                                                        CornerRadius="3"
                                                        Background="#48484A" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bar" Property="Width" Value="8" />
                                                        <Setter TargetName="Bar" Property="Background" Value="#5E5E60" />
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="Bar" Property="Width" Value="8" />
                                                        <Setter TargetName="Bar" Property="Background" Value="#6E6E70" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>

                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                                  Focusable="False"
                                                  IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="208" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#2A2A2C">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Margin="10,10,10,8" Height="28" CornerRadius="7" Background="#1E1E1E">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xE721;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="12" Foreground="#98989D"
                                   Margin="9,0,5,0" VerticalAlignment="Center" />
                        <Grid Grid.Column="1">
                            <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0"
                                     Foreground="#FFFFFF" CaretBrush="#FFFFFF" FontSize="13" Padding="0"
                                     VerticalContentAlignment="Center"
                                     TextChanged="Search_TextChanged" />
                            <TextBlock x:Name="SearchHint" Text="Search" FontSize="13"
                                       Foreground="#98989D" VerticalAlignment="Center"
                                       IsHitTestVisible="False" />
                        </Grid>
                    </Grid>
                </Border>

                <Rectangle Grid.Row="1" Height="1" Fill="#3A3A3C" Margin="12,0,12,6" />

                <ListBox x:Name="Pages" Grid.Row="2" Margin="10,0,10,10"
                         Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource NavRow}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectedIndex="0"
                         SelectionChanged="Pages_SelectionChanged">
                    <ListBoxItem Tag="General">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="20" Height="20" CornerRadius="5" Background="#8E8E93">
                                <TextBlock Text="&#xE713;"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="10" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Column="1" FontSize="13" Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Text="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" />
                        </Grid>
                    </ListBoxItem>

                    <ListBoxItem Tag="API Keys">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="20" Height="20" CornerRadius="5" Background="#FF9F0A">
                                <TextBlock Text="&#xE192;"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="10" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Column="1" FontSize="13" Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Text="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" />
                        </Grid>
                    </ListBoxItem>

                    <ListBoxItem Tag="About">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="20" Height="20" CornerRadius="5" Background="#8E8E93">
                                <TextBlock Text="&#xE946;"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="10" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Column="1" FontSize="13" Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Text="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" />
                        </Grid>
                    </ListBoxItem>
                </ListBox>

                <TextBlock x:Name="NoPages" Grid.Row="2" Text="No results" FontSize="12"
                           Foreground="#98989D" HorizontalAlignment="Center"
                           VerticalAlignment="Top" Margin="0,12,0,0"
                           Visibility="Collapsed" IsHitTestVisible="False" />
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <TextBlock x:Name="PageTitle" Text="General"
                           FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Rectangle Height="1" Fill="#3A3A3C" VerticalAlignment="Bottom" />
            </Grid>

            <ScrollViewer x:Name="ContentScroller" Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          PreviewMouseWheel="ContentScroller_PreviewMouseWheel">
                <Grid>
                    <StackPanel x:Name="GeneralPane" Margin="22,16,22,8">
                        <TextBlock Text="Time format" Style="{StaticResource SectionHeader}" />
                        <TextBlock Text="How the clock on the notch is written." FontSize="12"
                                   Foreground="#98989D" Margin="0,-4,0,12" />

                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="Card12" GroupName="TimeFormat" Tag="AM / PM"
                                         Style="{StaticResource FormatCard}" Checked="Format_Checked">
                                <StackPanel>
                                    <TextBlock HorizontalAlignment="Center" Foreground="#FFFFFF"
                                               FontSize="24" FontWeight="SemiBold"><Run x:Name="Sample12Clock" /><Run x:Name="Sample12Meridiem" FontSize="12" /></TextBlock>
                                    <TextBlock x:Name="Sample12Date" HorizontalAlignment="Center"
                                               Foreground="#98989D" FontSize="10" Margin="0,2,0,0" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="Card24" GroupName="TimeFormat" Tag="24-hour"
                                         Style="{StaticResource FormatCard}" Checked="Format_Checked"
                                         Margin="14,0,0,0">
                                <StackPanel>
                                    <TextBlock HorizontalAlignment="Center" Foreground="#FFFFFF"
                                               FontSize="24" FontWeight="SemiBold"><Run x:Name="Sample24Clock" /></TextBlock>
                                    <TextBlock x:Name="Sample24Date" HorizontalAlignment="Center"
                                               Foreground="#98989D" FontSize="10" Margin="0,2,0,0" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>

                        <TextBlock Text="Notch style" Style="{StaticResource SectionHeader}"
                                   Margin="0,22,0,8" />
                        <TextBlock Text="How the widget sits at the top of the screen. The attached notch hugs it; the floating notch floats clear of it and drops in when you reach for it."
                                   FontSize="12" Foreground="#98989D" TextWrapping="Wrap"
                                   Margin="0,-4,0,12" />

                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="CardNotch" GroupName="IslandStyle" Tag="Attached"
                                         Style="{StaticResource FormatCard}" Checked="Style_Checked">
                                <StackPanel Width="112">
                                    <Rectangle Height="1" Fill="#48484A" />
                                    <Border Width="56" Height="20" Background="Black"
                                            CornerRadius="0,0,10,10" HorizontalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="CardIsland" GroupName="IslandStyle" Tag="Floating"
                                         Style="{StaticResource FormatCard}" Checked="Style_Checked"
                                         Margin="14,0,0,0">
                                <StackPanel Width="112">
                                    <Rectangle Height="1" Fill="#48484A" />
                                    <Border Width="56" Height="20" Background="Black"
                                            CornerRadius="10" Margin="0,6,0,0"
                                            HorizontalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>

                        <TextBlock Text="Outline" Style="{StaticResource SectionHeader}"
                                   Margin="0,12,0,8" />

                        <Border Background="#2C2C2E" CornerRadius="9" Padding="14,10">
                            <Grid>
                                <StackPanel Margin="0,0,56,0">
                                    <TextBlock Text="Show outline" FontSize="13" Foreground="#FFFFFF" />
                                    <TextBlock Text="A hairline around the widget, so it reads as a shape and not a hole."
                                               FontSize="11" Foreground="#98989D" TextWrapping="Wrap"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                                <ToggleButton x:Name="OutlineSwitch" Style="{StaticResource Switch}"
                                              HorizontalAlignment="Right" VerticalAlignment="Top"
                                              Margin="0,1,0,0"
                                              Checked="Outline_Changed" Unchecked="Outline_Changed" />
                            </Grid>
                        </Border>

                        <TextBlock Text="Fullscreen" Style="{StaticResource SectionHeader}"
                                   Margin="0,20,0,8" />

                        <Border Background="#2C2C2E" CornerRadius="9" Padding="14,10">
                            <Grid>
                                <StackPanel Margin="0,0,56,0">
                                    <TextBlock Text="Step aside in fullscreen" FontSize="13" Foreground="#FFFFFF" />
                                    <TextBlock Text="Takes the widget off the screen, and stops it answering the pointer, while a fullscreen app is in front. Notifications are still kept in the history."
                                               FontSize="11" Foreground="#98989D" TextWrapping="Wrap"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                                <ToggleButton x:Name="FullscreenSwitch" Style="{StaticResource Switch}"
                                              HorizontalAlignment="Right" VerticalAlignment="Top"
                                              Margin="0,1,0,0"
                                              Checked="Fullscreen_Changed" Unchecked="Fullscreen_Changed" />
                            </Grid>
                        </Border>

                        <TextBlock Text="Reset" Style="{StaticResource SectionHeader}"
                                   Margin="0,24,0,8" />

                        <Border Background="#2C2C2E" CornerRadius="9" Padding="14,12">
                            <Grid>
                                <Grid x:Name="DeleteIntro">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="Delete all settings" FontSize="13" Foreground="#FFFFFF" />
                                        <TextBlock Text="Removes every file TopNotch keeps on this PC — preferences, API keys, launchpad shortcuts, pinned files and saved images. The app restarts afterwards."
                                                   FontSize="11" Foreground="#98989D" TextWrapping="Wrap"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                    <Button x:Name="DeleteSettingsButton" Content="Delete…"
                                            Style="{StaticResource DangerButton}"
                                            Grid.Column="1" VerticalAlignment="Center"
                                            Click="DeleteSettings_Click" />
                                </Grid>

                                <StackPanel x:Name="DeleteConfirm" Visibility="Collapsed">
                                    <TextBlock Text="Delete everything and restart?" FontSize="13"
                                               Foreground="#FFFFFF" />
                                    <TextBlock Text="This cannot be undone. TopNotch will open again as if it had just been installed."
                                               FontSize="11" Foreground="#98989D" TextWrapping="Wrap"
                                               Margin="0,3,0,0" />
                                    <TextBlock x:Name="DeleteError"
                                               Text="Some files could not be deleted. Close anything that is using them and try again."
                                               FontSize="11" Foreground="#FF453A" TextWrapping="Wrap"
                                               Margin="0,6,0,0" Visibility="Collapsed" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                Margin="0,10,0,0">
                                        <Button Content="Cancel" Style="{StaticResource QuietButton}"
                                                Click="CancelDelete_Click" />
                                        <Button x:Name="ConfirmDeleteButton" Content="Delete and Restart"
                                                Style="{StaticResource DangerButton}" Margin="8,0,0,0"
                                                Click="ConfirmDelete_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="ApiKeysPane" Margin="22,20,22,16" Visibility="Collapsed">
                        <TextBlock Text="ImgBB" Style="{StaticResource SectionHeader}" />
                        <TextBlock Text="Sharing an image uploads it to ImgBB and copies the link. That takes a free key of your own."
                                   FontSize="12" Foreground="#98989D" TextWrapping="Wrap"
                                   Margin="0,-4,0,12" />

                        <Border Background="#2C2C2E" CornerRadius="9" Padding="14,12">
                            <StackPanel>
                                <TextBlock Text="API key" FontSize="13" Foreground="#FFFFFF" />
                                <Border Background="#1E1E1E" CornerRadius="7" Height="30"
                                        Margin="0,8,0,0" BorderBrush="#3A3A3C" BorderThickness="1">
                                    <Grid>
                                        <TextBox x:Name="ApiKeyBox"
                                                 Background="Transparent" BorderThickness="0"
                                                 Foreground="#FFFFFF" CaretBrush="#FFFFFF"
                                                 SelectionBrush="#0A84FF" SelectionOpacity="0.4"
                                                 FontSize="13" Padding="9,0"
                                                 VerticalContentAlignment="Center"
                                                 TextChanged="ApiKeyBox_TextChanged"
                                                 LostFocus="ApiKeyBox_LostFocus" />
                                        <TextBlock x:Name="ApiKeyHint" Text="Paste your ImgBB API key"
                                                   FontSize="13" Foreground="#98989D" Margin="11,0,0,0"
                                                   VerticalAlignment="Center" IsHitTestVisible="False" />
                                    </Grid>
                                </Border>
                                <TextBlock x:Name="ApiKeyState" FontSize="11" Foreground="#98989D"
                                           Margin="0,8,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="How to get one" Style="{StaticResource SectionHeader}"
                                   Margin="0,20,0,8" />
                        <Border Background="#2C2C2E" CornerRadius="9" Padding="14,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="1" FontSize="12" Foreground="#98989D"
                                           Margin="0,0,10,0" />
                                <TextBlock Grid.Row="0" Grid.Column="1" FontSize="12" Foreground="#FFFFFF"
                                           TextWrapping="Wrap" Margin="0,0,0,6"
                                           Text="Create a free account at imgbb.com." />

                                <TextBlock Grid.Row="1" Text="2" FontSize="12" Foreground="#98989D"
                                           Margin="0,0,10,0" />
                                <TextBlock Grid.Row="1" Grid.Column="1" FontSize="12" Foreground="#FFFFFF"
                                           TextWrapping="Wrap" Margin="0,0,0,6"
                                           Text="Open api.imgbb.com and press Get API key." />

                                <TextBlock Grid.Row="2" Text="3" FontSize="12" Foreground="#98989D"
                                           Margin="0,0,10,0" />
                                <TextBlock Grid.Row="2" Grid.Column="1" FontSize="12" Foreground="#FFFFFF"
                                           TextWrapping="Wrap"
                                           Text="Copy the key shown there and paste it in the box above." />
                            </Grid>
                        </Border>

                        <Button Content="Open api.imgbb.com" Style="{StaticResource AccentButton}"
                                HorizontalAlignment="Left" Margin="0,14,0,0"
                                Click="OpenApiPage_Click" />
                    </StackPanel>

                    <StackPanel x:Name="AboutPane" Margin="22,20,22,16" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Sprites/tray.ico" Width="40" Height="40"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   VerticalAlignment="Top" />
                            <StackPanel Margin="12,1,0,0" VerticalAlignment="Center">
                                <TextBlock Text="TopNotch" FontSize="17" FontWeight="SemiBold"
                                           Foreground="#FFFFFF" />
                                <TextBlock x:Name="AboutVersion" FontSize="12" Foreground="#98989D"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="A notch at the top of the screen: what is playing, what is making the sound, the notifications that just arrived, and a place for the things you are working on."
                                   FontSize="12" Foreground="#98989D" TextWrapping="Wrap"
                                   Margin="0,14,0,0" />

                        <TextBlock Text="Updates" Style="{StaticResource SectionHeader}"
                                   Margin="0,22,0,8" />

                        <Border Background="#2C2C2E" CornerRadius="9" Padding="14,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="Version" FontSize="13" Foreground="#FFFFFF" />
                                    <TextBlock x:Name="UpdateState" FontSize="11" Foreground="#98989D"
                                               TextWrapping="Wrap" Margin="0,3,0,0"
                                               Text="Not checked yet." />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Button x:Name="CheckUpdatesButton" Content="Check Now"
                                            Style="{StaticResource QuietButton}"
                                            Click="CheckUpdates_Click" />
                                    <Button x:Name="DownloadButton" Content="Download"
                                            Style="{StaticResource AccentButton}" Margin="8,0,0,0"
                                            Visibility="Collapsed"
                                            Click="DownloadUpdate_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Background="#2C2C2E" CornerRadius="9" Padding="14,10"
                                Margin="0,8,0,0">
                            <Grid>
                                <StackPanel Margin="0,0,56,0">
                                    <TextBlock Text="Check on launch" FontSize="13" Foreground="#FFFFFF" />
                                    <TextBlock Text="Asks GitHub for a newer version when the app starts, and says so only if there is one."
                                               FontSize="11" Foreground="#98989D" TextWrapping="Wrap"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                                <ToggleButton x:Name="LaunchCheckSwitch" Style="{StaticResource Switch}"
                                              HorizontalAlignment="Right" VerticalAlignment="Top"
                                              Margin="0,1,0,0"
                                              Checked="LaunchCheck_Changed"
                                              Unchecked="LaunchCheck_Changed" />
                            </Grid>
                        </Border>

                        <Border Background="#2C2C2E" CornerRadius="9" Padding="14,10"
                                Margin="0,8,0,0">
                            <Grid>
                                <StackPanel Margin="0,0,56,0">
                                    <TextBlock Text="Include betas" FontSize="13" Foreground="#FFFFFF" />
                                    <TextBlock Text="Also treats pre-release versions as updates. They are marked Beta and may be less stable."
                                               FontSize="11" Foreground="#98989D" TextWrapping="Wrap"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                                <ToggleButton x:Name="BetaSwitch" Style="{StaticResource Switch}"
                                              HorizontalAlignment="Right" VerticalAlignment="Top"
                                              Margin="0,1,0,0"
                                              Checked="Beta_Changed"
                                              Unchecked="Beta_Changed" />
                            </Grid>
                        </Border>

                        <TextBlock Text="The check asks github.com for the newest release of this project. It sends nothing about you or this machine, and a copy that is already the newest is told nothing at all."
                                   FontSize="11" Foreground="#8E8E93" TextWrapping="Wrap"
                                   Margin="0,10,0,0" />

                        <Button Content="Open the project on GitHub" Style="{StaticResource QuietButton}"
                                HorizontalAlignment="Left" Margin="0,14,0,0"
                                Click="OpenGitHub_Click" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
