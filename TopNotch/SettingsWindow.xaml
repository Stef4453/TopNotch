<Window x:Class="TopNotch.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TopNotch"
        Title="TopNotch Settings"
        Icon="/Sprites/tray.ico"
        Width="760" Height="540"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="#1E1E1E"
        FontFamily="{StaticResource AppFont}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <!-- A plain window, deliberately: the island is a piece of theatre, but settings are where
         someone goes to change something, and there the familiar Windows window - title bar,
         minimise, close, Alt-Tab - is worth more than any amount of symmetry.

         The size is fixed, and CanMinimize rather than CanResize, because a settings window has
         one right size: the pages are laid out to fit it, and a window that can be dragged about
         only invites a corner being pulled until something is cut off. Minimise and close are
         still there; stretching it is not.

         Dark throughout, to match the widget it configures: the palette is the one macOS uses in
         dark mode, where the sidebar is the lighter of the two surfaces and the page sinks
         beneath it. -->
    <Window.Resources>
        <!-- Sidebar row: a quiet hover, and the blue bar macOS uses for the current page. -->
        <Style x:Key="NavRow" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" CornerRadius="6" Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#3A3A3C" />
                            </Trigger>
                            <!-- Listed after the hover so that the selected row keeps its colour
                                 under the pointer. -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#0A84FF" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The whole point of the two cards is that the choice can be read without knowing what
             either word means, so each one draws the clock as the island will draw it. The caption
             rides on Tag, which is what lets the checked state colour it: an element inside the
             content cannot be reached by a template trigger. -->
        <Style x:Key="FormatCard" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Background="Transparent">
                            <!-- The border is two pixels in both states rather than one and two,
                                 so that selecting a card does not nudge its contents sideways. -->
                            <Border x:Name="Card" Width="168" Height="86" CornerRadius="9"
                                    Background="#2C2C2E" BorderBrush="#3A3A3C" BorderThickness="2">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock x:Name="Caption" Text="{TemplateBinding Tag}"
                                       FontSize="11" Margin="0,7,0,0"
                                       HorizontalAlignment="Center" Foreground="#98989D" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="#3A3A3C" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="#0A84FF" />
                                <Setter TargetName="Caption" Property="Foreground" Value="#0A84FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#98989D" />
            <!-- The eight pixels below a heading are the step down to the line that explains it.
                 A heading that sets a top margin of its own - all but the first on a page - has to
                 restate them, because a Margin replaces this one rather than adding to it, and the
                 description below carries a negative top margin that would otherwise win. -->
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <!-- A filled button, for the one action on a page that leaves the app altogether. -->
        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fill" Background="#0A84FF" CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fill" Property="Background" Value="#2A95FF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Fill" Property="Background" Value="#0071E3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A quiet button: the same shape as the accent one without the fill. For the second
             action on a page - checking for updates, say - which is offered rather than urged. -->
        <Style x:Key="QuietButton" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fill" Background="#3A3A3C" CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fill" Property="Background" Value="#48484A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Fill" Property="Background" Value="#2C2C2E" />
                            </Trigger>
                            <!-- While a check is running the button is still there, in place, so
                                 that the page does not jump: only its colour says it cannot be
                                 pressed again. -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#8E8E93" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A yes-or-no setting, drawn the way macOS draws one: a track with a knob that slides
             across it. The knob travels in a sixth of a second, and the accent comes up behind it as
             a second track fading in rather than as an animated brush, which is the shorter road to
             the same picture. The knob sits centred with a translate rather than pinned to an edge,
             so that its two positions are one number apart and neither can be a pixel out. -->
        <Style x:Key="Switch" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent">
                            <Border Width="40" Height="24" CornerRadius="12" Background="#48484A" />
                            <Border x:Name="Fill" Width="40" Height="24" CornerRadius="12"
                                    Background="#0A84FF" Opacity="0" />
                            <Border x:Name="Knob" Width="18" Height="18" CornerRadius="9"
                                    Background="#FFFFFF"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="KnobShift" X="-8" />
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="KnobShift"
                                                             Storyboard.TargetProperty="X" To="8"
                                                             Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="Fill"
                                                             Storyboard.TargetProperty="Opacity" To="1"
                                                             Duration="0:0:0.16" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="KnobShift"
                                                             Storyboard.TargetProperty="X" To="-8"
                                                             Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="Fill"
                                                             Storyboard.TargetProperty="Opacity" To="0"
                                                             Duration="0:0:0.16" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="208" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="#2A2A2C">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Search. A real filter over the pages below, and one that reads the pages rather
                     than only their names: the words someone remembers are the ones they read on
                     the page, not the ones the sidebar happens to give it. -->
                <Border Grid.Row="0" Margin="10,10,10,8" Height="28" CornerRadius="7" Background="#1E1E1E">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xE721;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="12" Foreground="#98989D"
                                   Margin="9,0,5,0" VerticalAlignment="Center" />
                        <Grid Grid.Column="1">
                            <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0"
                                     Foreground="#FFFFFF" CaretBrush="#FFFFFF" FontSize="13" Padding="0"
                                     VerticalContentAlignment="Center"
                                     TextChanged="Search_TextChanged" />
                            <!-- A TextBox has no placeholder of its own; this sits over the empty
                                 box and stays out of the way of hit testing. -->
                            <TextBlock x:Name="SearchHint" Text="Search" FontSize="13"
                                       Foreground="#98989D" VerticalAlignment="Center"
                                       IsHitTestVisible="False" />
                        </Grid>
                    </Grid>
                </Border>

                <Rectangle Grid.Row="1" Height="1" Fill="#3A3A3C" Margin="12,0,12,6" />

                <!-- Pages. The row's Tag is its label, the name a pane is found by, and the first
                     thing the search matches on - it looks through the page itself as well, so a
                     setting can be found by what it says. Adding a page is a row here and a pane
                     opposite. -->
                <ListBox x:Name="Pages" Grid.Row="2" Margin="10,0,10,10"
                         Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource NavRow}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectedIndex="0"
                         SelectionChanged="Pages_SelectionChanged">
                    <ListBoxItem Tag="General">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="20" Height="20" CornerRadius="5" Background="#8E8E93">
                                <TextBlock Text="&#xE713;"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="10" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Column="1" FontSize="13" Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Text="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" />
                        </Grid>
                    </ListBoxItem>

                    <ListBoxItem Tag="API Keys">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="20" Height="20" CornerRadius="5" Background="#FF9F0A">
                                <TextBlock Text="&#xE192;"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="10" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Column="1" FontSize="13" Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Text="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" />
                        </Grid>
                    </ListBoxItem>

                    <ListBoxItem Tag="About">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="20" Height="20" CornerRadius="5" Background="#8E8E93">
                                <TextBlock Text="&#xE946;"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="10" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Column="1" FontSize="13" Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Text="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" />
                        </Grid>
                    </ListBoxItem>
                </ListBox>

                <!-- In place of the rows when a search has matched nothing. -->
                <TextBlock x:Name="NoPages" Grid.Row="2" Text="No results" FontSize="12"
                           Foreground="#98989D" HorizontalAlignment="Center"
                           VerticalAlignment="Top" Margin="0,12,0,0"
                           Visibility="Collapsed" IsHitTestVisible="False" />
            </Grid>
        </Border>

        <!-- Page -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Toolbar. Just the page's name: there is nowhere to go back or forward to, and two
                 chevrons that never do anything were two buttons pretending to. -->
            <Grid Grid.Row="0">
                <TextBlock x:Name="PageTitle" Text="General"
                           FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Rectangle Height="1" Fill="#3A3A3C" VerticalAlignment="Bottom" />
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <!-- General: how the clock is written. -->
                    <StackPanel x:Name="GeneralPane" Margin="22,16,22,8">
                        <TextBlock Text="Time format" Style="{StaticResource SectionHeader}" />
                        <TextBlock Text="How the clock on the notch is written." FontSize="12"
                                   Foreground="#98989D" Margin="0,-4,0,12" />

                        <!-- Live previews rather than pictures: the two cards are the setting, and
                             each one shows what picking it would put on the notch. -->
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="Card12" GroupName="TimeFormat" Tag="AM / PM"
                                         Style="{StaticResource FormatCard}" Checked="Format_Checked">
                                <StackPanel>
                                    <TextBlock HorizontalAlignment="Center" Foreground="#FFFFFF"
                                               FontSize="24" FontWeight="SemiBold"><Run x:Name="Sample12Clock" /><Run x:Name="Sample12Meridiem" FontSize="12" /></TextBlock>
                                    <TextBlock x:Name="Sample12Date" HorizontalAlignment="Center"
                                               Foreground="#98989D" FontSize="10" Margin="0,2,0,0" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="Card24" GroupName="TimeFormat" Tag="24-hour"
                                         Style="{StaticResource FormatCard}" Checked="Format_Checked"
                                         Margin="14,0,0,0">
                                <StackPanel>
                                    <TextBlock HorizontalAlignment="Center" Foreground="#FFFFFF"
                                               FontSize="24" FontWeight="SemiBold"><Run x:Name="Sample24Clock" /></TextBlock>
                                    <TextBlock x:Name="Sample24Date" HorizontalAlignment="Center"
                                               Foreground="#98989D" FontSize="10" Margin="0,2,0,0" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>

                        <TextBlock Text="Notch style" Style="{StaticResource SectionHeader}"
                                   Margin="0,22,0,8" />
                        <TextBlock Text="How the widget sits at the top of the screen. The attached notch hugs it; the floating notch floats clear of it and drops in when you reach for it."
                                   FontSize="12" Foreground="#98989D" TextWrapping="Wrap"
                                   Margin="0,-4,0,12" />

                        <!-- The difference drawn rather than described, and drawn to scale in the
                             one way that matters: whether the shape meets the top edge or hangs
                             clear of it. The line is the top of the screen. -->
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="CardNotch" GroupName="IslandStyle" Tag="Attached"
                                         Style="{StaticResource FormatCard}" Checked="Style_Checked">
                                <StackPanel Width="112">
                                    <Rectangle Height="1" Fill="#48484A" />
                                    <Border Width="56" Height="20" Background="Black"
                                            CornerRadius="0,0,10,10" HorizontalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="CardIsland" GroupName="IslandStyle" Tag="Floating"
                                         Style="{StaticResource FormatCard}" Checked="Style_Checked"
                                         Margin="14,0,0,0">
                                <StackPanel Width="112">
                                    <Rectangle Height="1" Fill="#48484A" />
                                    <!-- Six clear pixels below the edge, and round all the way
                                         round: this is the whole of the idea in one shape. -->
                                    <Border Width="56" Height="20" Background="Black"
                                            CornerRadius="10" Margin="0,6,0,0"
                                            HorizontalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>

                        <TextBlock Text="Outline" Style="{StaticResource SectionHeader}"
                                   Margin="0,12,0,8" />

                        <!-- A row rather than a pair of cards: there is nothing to draw for a
                             yes-or-no, and the two lines say all there is to say about it. -->
                        <Border Background="#2C2C2E" CornerRadius="9" Padding="14,10">
                            <Grid>
                                <!-- The switch needs its own strip on the right, and the words
                                     stop short of it rather than running underneath. -->
                                <StackPanel Margin="0,0,56,0">
                                    <TextBlock Text="Show outline" FontSize="13" Foreground="#FFFFFF" />
                                    <TextBlock Text="A hairline around the widget, so it reads as a shape and not a hole."
                                               FontSize="11" Foreground="#98989D" TextWrapping="Wrap"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                                <ToggleButton x:Name="OutlineSwitch" Style="{StaticResource Switch}"
                                              HorizontalAlignment="Right" VerticalAlignment="Top"
                                              Margin="0,1,0,0"
                                              Checked="Outline_Changed" Unchecked="Outline_Changed" />
                            </Grid>
                        </Border>

                        <TextBlock Text="Fullscreen" Style="{StaticResource SectionHeader}"
                                   Margin="0,20,0,8" />

                        <!-- Another row rather than a pair of cards: like the outline, it is a
                             yes-or-no, and the sentence under the name says the whole of it. -->
                        <Border Background="#2C2C2E" CornerRadius="9" Padding="14,10">
                            <Grid>
                                <StackPanel Margin="0,0,56,0">
                                    <TextBlock Text="Step aside in fullscreen" FontSize="13" Foreground="#FFFFFF" />
                                    <TextBlock Text="Takes the widget off the screen, and stops it answering the pointer, while a fullscreen app is in front. Notifications are still kept in the history."
                                               FontSize="11" Foreground="#98989D" TextWrapping="Wrap"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                                <ToggleButton x:Name="FullscreenSwitch" Style="{StaticResource Switch}"
                                              HorizontalAlignment="Right" VerticalAlignment="Top"
                                              Margin="0,1,0,0"
                                              Checked="Fullscreen_Changed" Unchecked="Fullscreen_Changed" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- API keys: the credentials the island's own features sign their requests
                         with. ImgBB is the only one so far. -->
                    <StackPanel x:Name="ApiKeysPane" Margin="22,20,22,16" Visibility="Collapsed">
                        <TextBlock Text="ImgBB" Style="{StaticResource SectionHeader}" />
                        <TextBlock Text="Sharing an image uploads it to ImgBB and copies the link. That takes a free key of your own."
                                   FontSize="12" Foreground="#98989D" TextWrapping="Wrap"
                                   Margin="0,-4,0,12" />

                        <Border Background="#2C2C2E" CornerRadius="9" Padding="14,12">
                            <StackPanel>
                                <TextBlock Text="API key" FontSize="13" Foreground="#FFFFFF" />
                                <Border Background="#1E1E1E" CornerRadius="7" Height="30"
                                        Margin="0,8,0,0" BorderBrush="#3A3A3C" BorderThickness="1">
                                    <Grid>
                                        <TextBox x:Name="ApiKeyBox"
                                                 Background="Transparent" BorderThickness="0"
                                                 Foreground="#FFFFFF" CaretBrush="#FFFFFF"
                                                 SelectionBrush="#0A84FF" SelectionOpacity="0.4"
                                                 FontSize="13" Padding="9,0"
                                                 VerticalContentAlignment="Center"
                                                 TextChanged="ApiKeyBox_TextChanged"
                                                 LostFocus="ApiKeyBox_LostFocus" />
                                        <!-- As in the island's link box: a TextBox has no placeholder
                                             of its own, so one sits over it and stays out of the way
                                             of hit testing. -->
                                        <TextBlock x:Name="ApiKeyHint" Text="Paste your ImgBB API key"
                                                   FontSize="13" Foreground="#98989D" Margin="11,0,0,0"
                                                   VerticalAlignment="Center" IsHitTestVisible="False" />
                                    </Grid>
                                </Border>
                                <TextBlock x:Name="ApiKeyState" FontSize="11" Foreground="#98989D"
                                           Margin="0,8,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="How to get one" Style="{StaticResource SectionHeader}"
                                   Margin="0,20,0,8" />
                        <Border Background="#2C2C2E" CornerRadius="9" Padding="14,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="1" FontSize="12" Foreground="#98989D"
                                           Margin="0,0,10,0" />
                                <TextBlock Grid.Row="0" Grid.Column="1" FontSize="12" Foreground="#FFFFFF"
                                           TextWrapping="Wrap" Margin="0,0,0,6"
                                           Text="Create a free account at imgbb.com." />

                                <TextBlock Grid.Row="1" Text="2" FontSize="12" Foreground="#98989D"
                                           Margin="0,0,10,0" />
                                <TextBlock Grid.Row="1" Grid.Column="1" FontSize="12" Foreground="#FFFFFF"
                                           TextWrapping="Wrap" Margin="0,0,0,6"
                                           Text="Open api.imgbb.com and press Get API key." />

                                <TextBlock Grid.Row="2" Text="3" FontSize="12" Foreground="#98989D"
                                           Margin="0,0,10,0" />
                                <TextBlock Grid.Row="2" Grid.Column="1" FontSize="12" Foreground="#FFFFFF"
                                           TextWrapping="Wrap"
                                           Text="Copy the key shown there and paste it in the box above." />
                            </Grid>
                        </Border>

                        <Button Content="Open api.imgbb.com" Style="{StaticResource AccentButton}"
                                HorizontalAlignment="Left" Margin="0,14,0,0"
                                Click="OpenApiPage_Click" />
                    </StackPanel>

                    <!-- About: what this is, which version of it is running, and the one place the
                         app talks to the internet about itself. Nothing here installs anything -
                         signing would be needed before that could be honest - so an update is a
                         release page to visit, and the button says so. -->
                    <StackPanel x:Name="AboutPane" Margin="22,20,22,16" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Sprites/tray.ico" Width="40" Height="40"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   VerticalAlignment="Top" />
                            <StackPanel Margin="12,1,0,0" VerticalAlignment="Center">
                                <TextBlock Text="TopNotch" FontSize="17" FontWeight="SemiBold"
                                           Foreground="#FFFFFF" />
                                <TextBlock x:Name="AboutVersion" FontSize="12" Foreground="#98989D"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="A notch at the top of the screen: what is playing, what is making the sound, the notifications that just arrived, and a place for the things you are working on."
                                   FontSize="12" Foreground="#98989D" TextWrapping="Wrap"
                                   Margin="0,14,0,0" />

                        <TextBlock Text="Updates" Style="{StaticResource SectionHeader}"
                                   Margin="0,22,0,8" />

                        <Border Background="#2C2C2E" CornerRadius="9" Padding="14,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="Version" FontSize="13" Foreground="#FFFFFF" />
                                    <TextBlock x:Name="UpdateState" FontSize="11" Foreground="#98989D"
                                               TextWrapping="Wrap" Margin="0,3,0,0"
                                               Text="Not checked yet." />
                                </StackPanel>
                                <!-- Both buttons are in the same row whether or not the download
                                     one is showing, so the card does not change height when a
                                     newer version turns up. -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Button x:Name="CheckUpdatesButton" Content="Check Now"
                                            Style="{StaticResource QuietButton}"
                                            Click="CheckUpdates_Click" />
                                    <Button x:Name="DownloadButton" Content="Download"
                                            Style="{StaticResource AccentButton}" Margin="8,0,0,0"
                                            Visibility="Collapsed"
                                            Click="DownloadUpdate_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Background="#2C2C2E" CornerRadius="9" Padding="14,10"
                                Margin="0,8,0,0">
                            <Grid>
                                <StackPanel Margin="0,0,56,0">
                                    <TextBlock Text="Check on launch" FontSize="13" Foreground="#FFFFFF" />
                                    <TextBlock Text="Asks GitHub for a newer version when the app starts, and says so only if there is one."
                                               FontSize="11" Foreground="#98989D" TextWrapping="Wrap"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                                <ToggleButton x:Name="LaunchCheckSwitch" Style="{StaticResource Switch}"
                                              HorizontalAlignment="Right" VerticalAlignment="Top"
                                              Margin="0,1,0,0"
                                              Checked="LaunchCheck_Changed"
                                              Unchecked="LaunchCheck_Changed" />
                            </Grid>
                        </Border>

                        <TextBlock Text="The check asks github.com for the newest release of this project. It sends nothing about you or this machine, and a copy that is already the newest is told nothing at all."
                                   FontSize="11" Foreground="#8E8E93" TextWrapping="Wrap"
                                   Margin="0,10,0,0" />

                        <Button Content="Open the project on GitHub" Style="{StaticResource QuietButton}"
                                HorizontalAlignment="Left" Margin="0,14,0,0"
                                Click="OpenGitHub_Click" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
