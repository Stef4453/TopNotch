<Window x:Name="Notch" x:Class="TopNotch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TopNotch"
        mc:Ignorable="d"
         WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        Width="500" Height="180"
        Loaded="Window_Loaded"
        RenderOptions.BitmapScalingMode="HighQuality"
        FontFamily="{StaticResource AppFont}">

    <Window.Resources>
        <Style TargetType="Image">
            <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
        </Style>

        <!-- AppFont is defined once, in App.xaml, because the settings window uses it too. -->

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.85" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleX="0.88" ScaleY="0.88" />
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Quick-action buttons. These get a surface of their own rather than just a glyph: they
             are the largest targets on the tab, the glyphs sit in a box larger than the artwork, and
             a template with no background only hit-tests where its content is, which would leave a
             dead ring around each icon. Flat rounded rectangles a shade lighter than the island. -->
        <Style x:Key="QuickActionButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="#22FFFFFF" CornerRadius="11">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#3AFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#4DFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Caption naming a quick-action tile. Shown only for the tile under the pointer, which is
             exactly why it can be a proper 12px - the size the tabs and the date are set at - instead
             of the 7px smudge that six permanent labels had to shrink to. For the same reason it is
             allowed to overhang its own 40px column: nothing else is showing to collide with.
             The line height is pinned rather than left to the font's metrics, because the two caption
             bands are part of the block's height and a metric that drifted would push the bottom row
             of tiles out of the tab. -->
        <Style x:Key="QuickActionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFB4B4B4" />
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="LineHeight" Value="15" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>

        <!-- Launchpad tiles. The button covers a whole cell of the grid rather than the 44px tile
             inside it, so a file dragged to the gap between two tiles still lands on the tile it
             was aimed at, while the tile itself stays a tidily separated square. An empty tile is
             an outline with a plus on it and a filled one is the app's own icon, and both are the
             same shape, so filling a tile changes nothing about the layout around it. -->
        <Style x:Key="LaunchpadTile" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Grid Width="44" Height="44"
                                  HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border x:Name="Plate" CornerRadius="12"
                                        Background="Transparent" BorderBrush="#73FFFFFF" BorderThickness="1" />

                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />

                                <!-- Giving an app up again, on hover only. It is deliberately small
                                     and over the icon's corner: a tile that can only ever be
                                     replaced is a tile that can never be emptied. -->
                                <Button x:Name="Remove" Style="{StaticResource IconButton}"
                                        Width="15" Height="15"
                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Margin="0,-4,-4,0" Opacity="0" Visibility="Collapsed"
                                        ToolTip="Remove" ToolTipService.IsEnabled="False"
                                        Click="LaunchpadRemove_Click">
                                    <Border Background="#E6000000" CornerRadius="7.5"
                                            BorderBrush="#66FFFFFF" BorderThickness="1">
                                        <TextBlock Text="&#xE711;"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="8" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Button>
                            </Grid>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Plate" Property="Background" Value="#1AFFFFFF" />
                                <Setter TargetName="Remove" Property="Opacity" Value="1" />
                            </Trigger>

                            <!-- An app is its own edge; the outline belongs to the empty tiles. -->
                            <DataTrigger Binding="{Binding IsEmpty}" Value="False">
                                <Setter TargetName="Plate" Property="BorderBrush" Value="Transparent" />
                                <Setter TargetName="Remove" Property="Visibility" Value="Visible" />
                            </DataTrigger>

                            <!-- The tile a dragged file is currently over, said out loud. -->
                            <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                <Setter TargetName="Plate" Property="Background" Value="#33FFFFFF" />
                                <Setter TargetName="Plate" Property="BorderBrush" Value="White" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- Only a tile with an app on it has a name to show. Left unset everywhere else,
                     because an empty tooltip is a box that says nothing.

                     The tool tip service is switched off wherever a tool tip is used like this: the
                     island draws tile names itself (see Island_MouseMove), because WPF's own tool
                     tips are drawn on the window's behalf and this window is never activated, and
                     left on, both plates would be on screen at once. -->
                <DataTrigger Binding="{Binding IsEmpty}" Value="False">
                    <Setter Property="ToolTip" Value="{Binding Name}" />
                    <Setter Property="ToolTipService.IsEnabled" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- What a tile holds: a plus, the app's icon, or the app's initial when its file had no
             icon to give. The plus is drawn rather than typed, so that it sits on the tile's
             middle without a font's idea of where a plus belongs. -->
        <DataTemplate x:Key="LaunchpadTileTemplate">
            <Button Style="{StaticResource LaunchpadTile}" Click="LaunchpadTile_Click">
                <Grid>
                    <Grid x:Name="Plus" Width="16" Height="16">
                        <Rectangle Width="16" Height="1.5" RadiusX="0.75" RadiusY="0.75" Fill="#8CFFFFFF"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Rectangle Width="1.5" Height="16" RadiusX="0.75" RadiusY="0.75" Fill="#8CFFFFFF"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>

                    <Image x:Name="Icon" Source="{Binding Icon}" Width="44" Height="44"
                           Visibility="Collapsed">
                        <Image.Clip>
                            <RectangleGeometry Rect="0,0,44,44" RadiusX="12" RadiusY="12" />
                        </Image.Clip>
                    </Image>

                    <TextBlock x:Name="Initial" Text="{Binding Initial}" Visibility="Collapsed"
                               Foreground="#B3FFFFFF" FontSize="17" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Button>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsEmpty}" Value="False">
                    <Setter TargetName="Plus" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Icon" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasIcon}" Value="False">
                    <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Initial" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- A file on the Clipboard board. It is a Border rather than a Button because a file is
             not pressed: it is picked up and put down again, and the two clicks that open it are the
             mouse's other gesture. A file's own picture does not fill the square it is given - a
             film's thumbnail is a wide strip, a photo can be a tall one - so the rounded plate
             behind it is what says where the file is and lights up under the pointer. -->
        <DataTemplate x:Key="ClipboardFileTemplate">
            <Border x:Name="Plate"
                    Width="44" Height="44" CornerRadius="12"
                    Background="Transparent" Cursor="Hand"
                    ToolTip="{Binding Name}" ToolTipService.IsEnabled="False"
                    MouseLeftButtonDown="ClipboardFile_Down">
                <Grid>
                    <Image x:Name="Preview" Source="{Binding Preview}"
                           Width="44" Height="44" Stretch="Uniform" Visibility="Collapsed" />

                    <TextBlock x:Name="Initial" Text="{Binding Initial}" Visibility="Collapsed"
                               Foreground="#B3FFFFFF" FontSize="17" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />

                    <!-- Giving a file up again, on hover only: the same badge the Launchpad uses,
                         for the same reason - the board is for the files on it, not for the ones
                         that were. -->
                    <Button x:Name="Remove" Style="{StaticResource IconButton}"
                            Width="15" Height="15"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,-4,-4,0" Opacity="0"
                            ToolTip="Remove" ToolTipService.IsEnabled="False"
                            Click="ClipboardRemove_Click">
                        <Border Background="#E6000000" CornerRadius="7.5"
                                BorderBrush="#66FFFFFF" BorderThickness="1">
                            <TextBlock Text="&#xE711;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="8" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Button>
                </Grid>
            </Border>

            <DataTemplate.Triggers>
                <Trigger SourceName="Plate" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Plate" Property="Background" Value="#1AFFFFFF" />
                    <Setter TargetName="Remove" Property="Opacity" Value="1" />
                </Trigger>

                <!-- The file being dragged, held above the others while it is on its way. -->
                <DataTrigger Binding="{Binding IsDragging}" Value="True">
                    <Setter TargetName="Plate" Property="Background" Value="#33FFFFFF" />
                    <Setter TargetName="Remove" Property="Opacity" Value="0" />
                </DataTrigger>

                <DataTrigger Binding="{Binding HasPreview}" Value="True">
                    <Setter TargetName="Preview" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasPreview}" Value="False">
                    <Setter TargetName="Initial" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Tile tooltips. The ones the system would draw are light; this is the same dark plate
             the rest of the island speaks in, so that naming an app does not flash a piece of
             Windows over it. -->
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#F21C1C1E" />
            <Setter Property="Foreground" Value="#FFEDEDED" />
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}" CornerRadius="7"
                                Padding="{TemplateBinding Padding}"
                                BorderBrush="#33FFFFFF" BorderThickness="1">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tab labels. Same weight for all of them: the strip is centred, so letting the active
             label get heavier would re-measure it and jog the whole strip sideways on every
             switch. Colour and the underline carry the state instead. Padding is horizontal-only
             so the underline beneath matches the label rather than the click target. -->
        <Style x:Key="TabButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#FF9A9A9A" />
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="0,1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Confirmation buttons. The cancel side is a quiet pill; the side that actually fires is
             filled, because at this size the labels alone don't make the primary choice obvious. -->
        <Style x:Key="ConfirmCancelButton" TargetType="Button">
            <Setter Property="Background" Value="#1AFFFFFF" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="13,4" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#38FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#52FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ConfirmAcceptButton" TargetType="Button" BasedOn="{StaticResource ConfirmCancelButton}">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#CCFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#A6FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="KnoblessSlider" TargetType="{x:Type local:KnoblessSlider}">
            <Setter Property="Height" Value="20"/>
            <Setter Property="Background" Value="#555555"/>
            <Setter Property="Foreground" Value="White"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type local:KnoblessSlider}">
                        <Grid Background="Transparent"
                      VerticalAlignment="Center">

                            <Track x:Name="PART_Track"
                           Height="6"
                           IsDirectionReversed="False">

                                <Track.DecreaseRepeatButton>
                                    <RepeatButton
                                Background="{TemplateBinding Foreground}"
                                BorderThickness="0"
                                Focusable="False"
                                IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="3"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>

                                <Track.IncreaseRepeatButton>
                                    <RepeatButton
                                Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                Focusable="False"
                                IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="3"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>

                                <Track.Thumb>
                                    <Thumb Width="0"
                                   Height="0"
                                   Opacity="0"
                                   Focusable="False"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- The island is drawn with its top three pixels above the top of the screen, which is what
         makes the notch borderless: there is no edge where it meets the screen, because there is no
         edge there. The window is taller than the island because the floating style has to drop in
         from above the screen; everything below the island is transparent, and a transparent pixel
         is one the mouse goes straight through to whatever is behind. -->
    <Grid x:Name="HoverZone"
      Background="Transparent"
      Width="460" Height="142"
      HorizontalAlignment="Center" VerticalAlignment="Top"
      MouseEnter="Zone_MouseEnter"
      MouseLeave="Zone_MouseLeave" Margin="0,-3,0,0"
      AllowDrop="True"
      DragOver="Island_DragOver"
      DragLeave="Island_DragLeave"
      Drop="Island_Drop">

        <Border x:Name="Island"
        Background="Black"
        CornerRadius="0,0,20,20"
        Width="460" Height="142"
        VerticalAlignment="Top"
        MouseLeftButtonDown="Island_Click"
        MouseMove="Island_MouseMove"
        MouseLeave="Island_MouseLeave">
            <Border.RenderTransform>
                <TranslateTransform x:Name="IslandShift" Y="-0" />
            </Border.RenderTransform>

            <Grid>
                <!-- Shown only when the island is expanded -->
                <Grid x:Name="ExpandedContent" Visibility="Visible" ClipToBounds="True">
                    <Grid Margin="16,6,16,6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <!-- tab strip -->
                            <RowDefinition Height="*" />
                            <!-- tab content -->
                        </Grid.RowDefinitions>

                        <!-- Tab strip. Each label carries its own underline, laid out from the
                             start and merely transparent while inactive, so the strip keeps its
                             height and the labels never shift. -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,1,0,3">
                            <StackPanel Margin="9,0">
                                <Button x:Name="HomeTab" Content="Home" Style="{StaticResource TabButton}" Click="Tab_Click" />
                                <Border x:Name="HomeUnderline" Height="3" CornerRadius="1.5"
                                        Background="White" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel Margin="9,0">
                                <Button x:Name="MediaTab" Content="Media" Style="{StaticResource TabButton}" Click="Tab_Click" />
                                <Border x:Name="MediaUnderline" Height="3" CornerRadius="1.5"
                                        Background="White" Margin="0,3,0,0" Opacity="0" />
                            </StackPanel>
                            <StackPanel Margin="9,0">
                                <Button x:Name="HistoryTab" Content="History" Style="{StaticResource TabButton}" Click="Tab_Click" />
                                <Border x:Name="HistoryUnderline" Height="3" CornerRadius="1.5"
                                        Background="White" Margin="0,3,0,0" Opacity="0" />
                            </StackPanel>
                            <StackPanel Margin="9,0">
                                <Button x:Name="LaunchpadTab" Content="Launchpad" Style="{StaticResource TabButton}" Click="Tab_Click" />
                                <Border x:Name="LaunchpadUnderline" Height="3" CornerRadius="1.5"
                                        Background="White" Margin="0,3,0,0" Opacity="0" />
                            </StackPanel>
                            <StackPanel Margin="9,0">
                                <Button x:Name="ClipboardTab" Content="Clipboard" Style="{StaticResource TabButton}" Click="Tab_Click" />
                                <Border x:Name="ClipboardUnderline" Height="3" CornerRadius="1.5"
                                        Background="White" Margin="0,3,0,0" Opacity="0" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Tab content container (clipped to prevent spill outside tab area) -->
                        <Grid Grid.Row="1" ClipToBounds="True">
                            <Grid x:Name="TabContentHost">
                                <Grid.RenderTransform>
                                    <TranslateTransform x:Name="TabContentShift" />
                                </Grid.RenderTransform>

                                <!-- Home tab: quick actions, clock, then usage, left to right. The
                                     bars are sized in code-behind (which is why the fills start at
                                     zero). -->
                                <Grid x:Name="HomeContent" Visibility="Visible">
                                    <!-- The side blocks are pinned to the outer edges and the clock
                                         below spans all three columns, so it sits on the island's
                                         centreline; the blocks are deliberately the same width so
                                         the gap between each of them and the clock matches too. -->
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />   <!-- quick actions, hard left -->
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />   <!-- usage, hard right -->
                                    </Grid.ColumnDefinitions>

                                    <!-- Quick actions: the largest thing on the tab, and the reason to
                                         open it. A fixed three-by-two grid of 36x30 tiles, every cell
                                         taken - four session actions, a link shortener and a
                                         placeholder. The block is exactly as wide as the usage block
                                         opposite (120px), and since the clock is centred that is what
                                         puts it the same distance from the buttons as from the
                                         indicators.
                                         Each row of tiles has a caption line and it sits on the outer
                                         side of the block - above the top row, below the bottom row -
                                         so a label is always the closest text to the tile it names and
                                         never lands between the two rows, where it would read as a
                                         label for the pair. The two lines are reserved, so nothing
                                         reflows when one appears, and empty at rest: six permanent
                                         labels would shout over the clock, and at 7px - the only size
                                         that fitted six of them - they were barely readable anyway. -->
                                    <Grid Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="40" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />   <!-- top row's caption line -->
                                            <RowDefinition Height="30" />     <!-- top row of tiles -->
                                            <RowDefinition Height="6" />      <!-- gutter -->
                                            <RowDefinition Height="30" />     <!-- bottom row of tiles -->
                                            <RowDefinition Height="Auto" />   <!-- bottom row's caption line -->
                                        </Grid.RowDefinitions>

                                        <!-- Each icon is drawn at a slightly different box size
                                             because the exported canvases carry different amounts of
                                             padding; these sizes put the glyphs at a common 22px,
                                             which is the share of the tile the artwork has always
                                             taken. picture.png is a landscape glyph, so its box ends
                                             up taller than the button; the excess is transparent
                                             canvas. Tag carries the name the caption line shows, and
                                             a tile in the leftmost column needs a short one: the
                                             caption overhangs the block happily on the right, where the
                                             gap and the clock are, but the tab content is clipped at
                                             the block's left edge, so nothing may run off that side.
                                             "Power" is the long name there - "Shut Down" would lose its
                                             first letter. -->
                                        <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource QuickActionButton}"
                                                Width="36" Height="30" HorizontalAlignment="Center" VerticalAlignment="Top"
                                                Tag="Power"
                                                MouseEnter="QuickAction_PointerEnter" MouseLeave="QuickAction_PointerLeave"
                                                Click="Shutdown_Click">
                                            <Image Source="/Sprites/power.png" Width="27" Height="27" />
                                        </Button>

                                        <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource QuickActionButton}"
                                                Width="36" Height="30" HorizontalAlignment="Center" VerticalAlignment="Top"
                                                Tag="Restart"
                                                MouseEnter="QuickAction_PointerEnter" MouseLeave="QuickAction_PointerLeave"
                                                Click="Restart_Click">
                                            <Image Source="/Sprites/restart.png" Width="27" Height="27" />
                                        </Button>

                                        <Button Grid.Row="3" Grid.Column="0" Style="{StaticResource QuickActionButton}"
                                                Width="36" Height="30" HorizontalAlignment="Center" VerticalAlignment="Top"
                                                Tag="Sleep"
                                                MouseEnter="QuickAction_PointerEnter" MouseLeave="QuickAction_PointerLeave"
                                                Click="Sleep_Click">
                                            <Image Source="/Sprites/sleep.png" Width="23" Height="23" />
                                        </Button>

                                        <Button Grid.Row="3" Grid.Column="1" Style="{StaticResource QuickActionButton}"
                                                Width="36" Height="30" HorizontalAlignment="Center" VerticalAlignment="Top"
                                                Tag="Lock"
                                                MouseEnter="QuickAction_PointerEnter" MouseLeave="QuickAction_PointerLeave"
                                                Click="Lock_Click">
                                            <Image Source="/Sprites/lock.png" Width="25" Height="25" />
                                        </Button>

                                        <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource QuickActionButton}"
                                                Width="36" Height="30" HorizontalAlignment="Center" VerticalAlignment="Top"
                                                Tag="Shorten Link"
                                                MouseEnter="QuickAction_PointerEnter" MouseLeave="QuickAction_PointerLeave"
                                                Click="ShortenUrl_Click">
                                            <Image Source="/Sprites/link.png" Width="22" Height="22" />
                                        </Button>

                                        <!-- Share Image: the island's one drop target. The button
                                             itself opens the explanation of how to use it; the drop
                                             is taken by the island as a whole, so a picture only has
                                             to be brought near the notch rather than landed on a
                                             36x30 tile. -->
                                        <Button x:Name="ShareImageButton"
                                                Grid.Row="3" Grid.Column="2" Style="{StaticResource QuickActionButton}"
                                                Width="36" Height="30" HorizontalAlignment="Center" VerticalAlignment="Top"
                                                Tag="Share Image"
                                                MouseEnter="QuickAction_PointerEnter" MouseLeave="QuickAction_PointerLeave"
                                                Click="ShareImage_Click">
                                            <Image Source="/Sprites/picture.png" Width="33" Height="33" />
                                        </Button>

                                        <!-- Caption lines: one above the top row, one below the bottom
                                             row, each bottom- or top-aligned inside its own band so it
                                             hugs its tiles and is nowhere near the other row's. Each
                                             spans the whole block and is slid sideways until it centres
                                             under the hovered column - a name wider than its own 40px
                                             column would be clipped to that column, and nothing is
                                             beside it here to collide with. -->
                                        <TextBlock x:Name="TopRowCaption" Grid.Row="0" Grid.ColumnSpan="3"
                                                   VerticalAlignment="Bottom" Margin="0,0,0,2" Opacity="0"
                                                   Style="{StaticResource QuickActionLabel}">
                                            <TextBlock.RenderTransform>
                                                <TranslateTransform x:Name="TopRowCaptionShift" />
                                            </TextBlock.RenderTransform>
                                        </TextBlock>

                                        <TextBlock x:Name="BottomRowCaption" Grid.Row="4" Grid.ColumnSpan="3"
                                                   VerticalAlignment="Top" Margin="0,2,0,0" Opacity="0"
                                                   Style="{StaticResource QuickActionLabel}">
                                            <TextBlock.RenderTransform>
                                                <TranslateTransform x:Name="BottomRowCaptionShift" />
                                            </TextBlock.RenderTransform>
                                        </TextBlock>
                                    </Grid>

                                    <!-- Clock. It spans all three columns rather than sitting in the
                                         middle one, so it lands on the island's centreline whatever
                                         the two side blocks measure; because those blocks are the
                                         same width, that also makes the gaps either side of the
                                         digits equal. -->
                                    <StackPanel Grid.Column="0" Grid.ColumnSpan="3"
                                                VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <!-- Two runs instead of one string so the AM/PM designator can
                                             be drawn smaller while still sitting on the digits' baseline.
                                             No whitespace between the runs on purpose: the space that
                                             separates them is the designator's own leading space, and
                                             letting XAML insert another would double it. -->
                                        <TextBlock Foreground="White" FontFamily="{StaticResource AppFont}"
                                                   FontSize="40" FontWeight="SemiBold"
                                                   HorizontalAlignment="Left"><Run x:Name="ClockTimeRun" Text="--:--" /><Run x:Name="ClockMeridiemRun" Text=" --" FontSize="20" /></TextBlock>
                                        <TextBlock x:Name="DateText" Text=""
                                                   Foreground="#FFBDBDBD" FontFamily="{StaticResource AppFont}"
                                                   FontSize="13"
                                                   Margin="3,3,0,0" HorizontalAlignment="Left" />
                                    </StackPanel>

                                    <!-- Usage, hard against the right edge and still the quietest
                                         thing on the tab: worth a glance, never the reason to look
                                         here. Its width is deliberately the same as the quick-action
                                         block opposite, because the clock between them is centred -
                                         equal blocks are what leave equal gaps on either side of it.
                                         The fixed width also keeps the bars a legible length rather
                                         than stretching them across whatever the column measures.
                                         Like the media card, it is given the height it had before
                                         the island grew for the Home tab's captions and centred in
                                         the taller tab: its two halves split the height between them,
                                         so otherwise they drift apart and the pair stops reading as
                                         one block. -->
                                    <Grid Grid.Column="2" Width="120" HorizontalAlignment="Right"
                                          Height="88" VerticalAlignment="Center">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <!-- CPU -->
                                        <Grid Grid.Row="0" VerticalAlignment="Center">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Text="CPU"
                                                       Foreground="White" FontFamily="{StaticResource AppFont}"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       HorizontalAlignment="Left" />
                                            <TextBlock x:Name="CpuPercentText" Grid.Row="0" Text="--%"
                                                       Foreground="#FFBDBDBD" FontFamily="{StaticResource AppFont}"
                                                       FontSize="10"
                                                       HorizontalAlignment="Right" />

                                            <Border x:Name="CpuTrack" Grid.Row="1" Height="4" CornerRadius="2"
                                                    Background="#3D3D3D" Margin="0,3,0,0">
                                                <Border x:Name="CpuFill" Height="4" CornerRadius="2"
                                                        Background="White" HorizontalAlignment="Left" Width="0" />
                                            </Border>
                                        </Grid>

                                        <!-- Memory -->
                                        <Grid Grid.Row="1" VerticalAlignment="Center">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Text="Memory"
                                                       Foreground="White" FontFamily="{StaticResource AppFont}"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       HorizontalAlignment="Left" />
                                            <TextBlock x:Name="MemoryPercentText" Grid.Row="0" Text="--%"
                                                       Foreground="#FFBDBDBD" FontFamily="{StaticResource AppFont}"
                                                       FontSize="10"
                                                       HorizontalAlignment="Right" />

                                            <Border x:Name="MemoryTrack" Grid.Row="1" Height="4" CornerRadius="2"
                                                    Background="#3D3D3D" Margin="0,3,0,0">
                                                <Border x:Name="MemoryFill" Height="4" CornerRadius="2"
                                                        Background="White" HorizontalAlignment="Left" Width="0" />
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Grid>

                                <!-- Media tab. The card is deliberately compact - the artwork and the
                                     transport buttons are pinned to the top and bottom of it, and
                                     the volume slider centres in what is left - so left to itself it
                                     stretches with the tab and the two halves drift apart. It is
                                     given the height it had before the island grew to make room for
                                     the Home tab's captions, and centred in the taller tab, so the
                                     spacing is exactly what it always was. -->
                                <Grid x:Name="MediaContent" Visibility="Collapsed"
                                      Height="88" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <!-- Media part (~70%) -->
                                        <ColumnDefinition Width="7*" />
                                        <!-- Device part (~30%) -->
                                        <ColumnDefinition Width="3*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Media part -->
                                    <Grid Grid.Column="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="64" />
                                            <!-- album art -->
                                            <ColumnDefinition Width="*" />
                                            <!-- everything else -->
                                        </Grid.ColumnDefinitions>

                                        <Image x:Name="AlbumCover" HorizontalAlignment="Center" Height="50"
                                       VerticalAlignment="Top" Width="50"
                                       Source="/Sprites/Empty.png" RenderTransformOrigin="0.5,0.5">
                                            <Image.Clip>
                                                <RectangleGeometry Rect="0,0,50,50" RadiusX="15" RadiusY="15" />
                                            </Image.Clip>
                                        </Image>

                                        <!-- Text container clipped to column bounds so sliding text doesn't overflow -->
                                        <Grid Grid.Column="1" Margin="8,0,0,0" ClipToBounds="True">
                                            <Grid x:Name="TrackInfoPanel">
                                                <Grid.RenderTransform>
                                                    <TranslateTransform x:Name="TrackInfoShift" />
                                                </Grid.RenderTransform>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <!-- title -->
                                                    <RowDefinition Height="Auto" />
                                                    <!-- artist -->
                                                </Grid.RowDefinitions>

                                                <TextBlock x:Name="TrackTitle" Text="Track"
                                           Foreground="White" FontFamily="{StaticResource AppFont}"
                                           VerticalAlignment="Center" Height="24"
                                           TextTrimming="CharacterEllipsis" TextAlignment="Left" HorizontalAlignment="Left" Width="175" />
                                                <TextBlock x:Name="ArtistName" Text="Artist" Grid.Row="1"
                                           Foreground="#FFBDBDBD" FontFamily="{StaticResource AppFont}"
                                           VerticalAlignment="Center" Height="24"
                                           TextTrimming="CharacterEllipsis" TextAlignment="Left" HorizontalAlignment="Left" />
                                            </Grid>
                                        </Grid>

                                        <!-- Transport buttons: span both columns and center on the media area -->
                                        <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal"
                                                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4">
                                            <Button x:Name="LastButton" Style="{StaticResource IconButton}"
                                                Width="28" Height="28" Margin="8,0"
                                                Click="Last_Click">
                                                <Image x:Name="Last" Source="/Sprites/back.png" />
                                            </Button>
                                            <Button x:Name="PlayPauseButton" Style="{StaticResource IconButton}"
                                                Width="28" Height="28" Margin="8,0"
                                                Click="PlayPause_Click">
                                                <Image x:Name="PlayPause" Source="/Sprites/play.png" />
                                            </Button>
                                            <Button x:Name="NextButton" Style="{StaticResource IconButton}"
                                                Width="28" Height="28" Margin="8,0"
                                                Click="Next_Click">
                                                <Image x:Name="Next" Source="/Sprites/forward.png" />
                                            </Button>
                                        </StackPanel>

                                        <!-- Now-playing waveform, pinned to the bottom-right of the media area -->
                                        <local:GifImage x:Name="ExpandedWave" Grid.ColumnSpan="2"
                                                        SourceUri="/Sprites/music_waveform.gif"
                                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                                        Height="16" Width="16" Margin="0,0,8,4"
                                                        RenderOptions.BitmapScalingMode="HighQuality"
                                                        Visibility="Collapsed" />
                                    </Grid>

                                    <!-- Separator between the media and device sides -->
                                    <Border Grid.Column="0" Width="1"
                                            HorizontalAlignment="Right"
                                            Background="#33FFFFFF"
                                            Margin="0,6,0,6" />

                                    <!-- Device part: audio icon, device name and volume bar -->
                                    <Grid Grid.Column="1" Margin="10,0,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <Image x:Name="DeviceIcon" Grid.Row="0"
                                               Height="16" Width="16"
                                               HorizontalAlignment="Center"
                                               Source="/Sprites/bluetooth_audio.png"
                                               SnapsToDevicePixels="True"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                        <TextBlock x:Name="DeviceNameText" Grid.Row="1"
                                                   Text="Connected Device"
                                                   Foreground="White" FontFamily="{StaticResource AppFont}"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   TextAlignment="Center" VerticalAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   ClipToBounds="True"
                                                   Height="36"
                                                   Margin="0,2,0,0" />

                                        <local:KnoblessSlider x:Name="Volume" Grid.Row="2"
                                            Style="{StaticResource KnoblessSlider}"
                                            VerticalAlignment="Center"
                                            Minimum="0" Maximum="100"
                                            Margin="0,0,0,2" Height="20" Cursor="Hand" />
                                    </Grid>
                                </Grid>

                                <!-- History tab: every notification seen this session, newest first.
                                     Scrolling is snapped to whole rows (see SnapScrollViewer). -->
                                <Grid x:Name="HistoryContent" Visibility="Collapsed">
                                    <local:SnapScrollViewer x:Name="HistoryScroller"
                                                            SnapInterval="36"
                                                            VerticalScrollBarVisibility="Hidden"
                                                            HorizontalScrollBarVisibility="Disabled"
                                                            Focusable="False"
                                                            ClipToBounds="True">
                                        <ItemsControl x:Name="HistoryList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Height="{Binding SnapInterval, RelativeSource={RelativeSource AncestorType={x:Type local:SnapScrollViewer}}}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <Image Grid.Column="0" Width="24" Height="24"
                                                               VerticalAlignment="Center"
                                                               Source="{Binding Icon}">
                                                            <Image.Clip>
                                                                <RectangleGeometry Rect="0,0,24,24" RadiusX="6" RadiusY="6" />
                                                            </Image.Clip>
                                                        </Image>

                                                        <Grid Grid.Column="1" Margin="8,0,0,0">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="*" />
                                                                <RowDefinition Height="*" />
                                                            </Grid.RowDefinitions>

                                                            <TextBlock Grid.Row="0" Text="{Binding Title}"
                                                                       Foreground="White" FontFamily="{StaticResource AppFont}"
                                                                       FontSize="12" FontWeight="SemiBold"
                                                                       VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Grid.Row="1" Text="{Binding Body}"
                                                                       Foreground="#FFBDBDBD" FontFamily="{StaticResource AppFont}"
                                                                       FontSize="11"
                                                                       VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </Grid>

                                                        <TextBlock Grid.Column="2" Text="{Binding TimeText}"
                                                                   Foreground="#FF7A7A7A" FontFamily="{StaticResource AppFont}"
                                                                   FontSize="10"
                                                                   VerticalAlignment="Center" Margin="8,0,0,0" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </local:SnapScrollViewer>

                                    <TextBlock x:Name="HistoryEmpty" Text="No notifications yet"
                                               Foreground="#FF8A8A8A" FontFamily="{StaticResource AppFont}"
                                               FontSize="12"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>

                                <!-- Launchpad tab: the apps that have been dropped here, in a grid
                                     that fills the panel. Rows only, because a UniformGrid works its
                                     columns out from the number of tiles it is handed - so the size
                                     of the panel is written down once, in Launchpad.SlotCount, and
                                     the tiles arrange themselves around it. -->
                                <Grid x:Name="LaunchpadContent" Visibility="Collapsed">
                                    <ItemsControl x:Name="LaunchpadList"
                                                  ItemTemplate="{StaticResource LaunchpadTileTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="2" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>

                                    <!-- The Launchpad's one page of writing, shown over the grid
                                         the first time the tab is ever opened and never again.
                                         Opaque black rather than a translucent veil: the empty
                                         tiles behind it say nothing, and sixteen outlines showing
                                         through a paragraph would be a great deal of noise around
                                         very little text. Clicking anywhere on it - the plate or
                                         the button - puts it away, which is the whole of what it
                                         asks of anybody who has read it. -->
                                    <Grid x:Name="LaunchpadIntro" Background="Black"
                                          Visibility="Collapsed"
                                          MouseLeftButtonDown="LaunchpadIntro_Click">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center"
                                                    Margin="2,0,0,0">
                                            <TextBlock Text="Your Launchpad"
                                                       Foreground="White"
                                                       FontFamily="{StaticResource AppFont}"
                                                       FontSize="13" FontWeight="SemiBold" />

                                            <TextBlock Margin="0,5,0,0"
                                                       Foreground="#FFB4B4B4"
                                                       FontFamily="{StaticResource AppFont}"
                                                       FontSize="11" LineHeight="15"
                                                       LineStackingStrategy="BlockLineHeight"
                                                       TextWrapping="Wrap"
                                                       Text="Drag an app onto a square to keep it here." />

                                            <TextBlock Margin="0,2,0,0"
                                                       Foreground="#FFB4B4B4"
                                                       FontFamily="{StaticResource AppFont}"
                                                       FontSize="11" LineHeight="15"
                                                       LineStackingStrategy="BlockLineHeight"
                                                       TextWrapping="Wrap"
                                                       Text="Click a square to pick an app from your PC." />

                                            <TextBlock Margin="0,2,0,0"
                                                       Foreground="#FFB4B4B4"
                                                       FontFamily="{StaticResource AppFont}"
                                                       FontSize="11" LineHeight="15"
                                                       LineStackingStrategy="BlockLineHeight"
                                                       TextWrapping="Wrap"
                                                       Text="Click a tile to open it. Hover it and click × to remove." />
                                        </StackPanel>

                                        <Button Grid.Column="1" Content="OK"
                                                Style="{StaticResource ConfirmAcceptButton}"
                                                VerticalAlignment="Center" Margin="14,0,0,0"
                                                Click="LaunchpadIntro_Click" />
                                    </Grid>
                                </Grid>

                                <!-- Clipboard tab: files dropped anywhere on the panel, and dragged
                                     about from there. There is no grid here on purpose - the board
                                     is the whole panel and the place a file is left is the place it
                                     stays - so the panel is a Canvas and each file carries the
                                     corner it sits at. What a file opens with is the shell's
                                     business, so any file at all is taken here, where the Launchpad
                                     takes only the ones it could open. -->
                                <Grid x:Name="ClipboardContent" Visibility="Collapsed">
                                    <!-- Lights up while a file is over the board: the whole panel is
                                         where it will land, so the whole panel is what says so. Out
                                         of the mouse's way, so the drop - which the island takes,
                                         not the panel - and the files themselves pass through it
                                         as though it were not there. -->
                                    <Border x:Name="ClipboardBoard" CornerRadius="12"
                                            BorderThickness="1" BorderBrush="Transparent"
                                            IsHitTestVisible="False" />

                                    <!-- Inset a little, so that a file at the very edge of the board
                                         sits inside the frame rather than on it. -->
                                    <ItemsControl x:Name="ClipboardList"
                                                  ItemTemplate="{StaticResource ClipboardFileTemplate}"
                                                  Margin="3"
                                                  SizeChanged="ClipboardList_SizeChanged"
                                                  MouseMove="ClipboardList_Move"
                                                  MouseLeftButtonUp="ClipboardList_Up"
                                                  LostMouseCapture="ClipboardList_LostCapture">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>

                                        <!-- A file's place on the board is the file's own, so the
                                             container is put where the file says it is and the
                                             Canvas does the rest. -->
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Canvas.Left" Value="{Binding X}" />
                                                <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                    </ItemsControl>

                                    <!-- What the board says while there is nothing on it: what it is
                                         for, and the two things a file does that dragging is not.
                                         Behind the files and out of the mouse's way, so that the
                                         first file can be dropped straight onto it. -->
                                    <StackPanel x:Name="ClipboardHint" IsHitTestVisible="False"
                                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasItems, ElementName=ClipboardList}"
                                                                 Value="False">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>

                                        <TextBlock Text="Drag files here"
                                                   Foreground="#FFB4B4B4"
                                                   FontFamily="{StaticResource AppFont}"
                                                   FontSize="13" HorizontalAlignment="Center" />

                                        <TextBlock Margin="0,3,0,0"
                                                   Text="Double-click one to open it · Drag anywhere · Hover it and click × to remove"
                                                   Foreground="#8CFFFFFF"
                                                   FontFamily="{StaticResource AppFont}"
                                                   FontSize="11" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>

                    <!-- Quick-action confirmation. Blankets the whole island, tab strip included,
                         so the only things clickable while an action is armed are these two
                         buttons. Clicking anywhere else lands on Island_Click, which abandons it.
                         A Border rather than a Grid purely so it can carry CornerRadius: a plain
                         black rectangle would paint over the notches the island's rounded bottom
                         corners leave open and square them off. Must match the Island Border. -->
                    <Border x:Name="ConfirmOverlay" Background="Black" CornerRadius="0,0,20,20"
                            Visibility="Collapsed">
                        <!-- Prompt above the buttons, both centred. The text stretches to the width
                             of the button row and centres itself over it. -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="ConfirmPrompt" Text="Shut down?"
                                       Foreground="White" FontFamily="{StaticResource AppFont}"
                                       FontSize="15" FontWeight="SemiBold"
                                       TextAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                        Margin="0,10,0,0">
                                <Button Content="Cancel" Style="{StaticResource ConfirmCancelButton}"
                                        Click="ConfirmCancel_Click" />
                                <Button x:Name="ConfirmAccept" Content="Shut down"
                                        Style="{StaticResource ConfirmAcceptButton}"
                                        Margin="8,0,0,0" Click="ConfirmAccept_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Link input. Blankets the island for the same reasons as the prompt above:
                         the tab strip and the quick actions stay out of reach while it is open, and
                         a click on the backdrop closes it. The placeholder is a TextBlock rather
                         than a watermark because a TextBox has no placeholder of its own; it sits
                         over the box, out of the way of hit testing. -->
                    <Border x:Name="UrlOverlay" Background="Black" CornerRadius="0,0,20,20"
                            Visibility="Collapsed"
                            PreviewKeyDown="UrlOverlay_PreviewKeyDown">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Width="428">
                            <Border Background="#1AFFFFFF" CornerRadius="10" Height="34">
                                <Grid>
                                    <TextBox x:Name="UrlBox"
                                             Background="Transparent" BorderThickness="0"
                                             Foreground="White" CaretBrush="White"
                                             SelectionBrush="White" SelectionOpacity="0.35"
                                             FontFamily="{StaticResource AppFont}" FontSize="13"
                                             Padding="10,0" VerticalContentAlignment="Center"
                                             TextChanged="UrlBox_TextChanged" />
                                    <TextBlock x:Name="UrlHint" Text="Paste or type a link"
                                               Foreground="#FF7A7A7A" FontFamily="{StaticResource AppFont}"
                                               FontSize="13" Margin="11,0,0,0"
                                               VerticalAlignment="Center" IsHitTestVisible="False" />
                                </Grid>
                            </Border>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                        Margin="0,10,0,0">
                                <Button Content="Cancel" Style="{StaticResource ConfirmCancelButton}"
                                        Click="UrlCancel_Click" />
                                <Button Content="Shorten" Style="{StaticResource ConfirmAcceptButton}"
                                        Margin="8,0,0,0" Click="UrlShorten_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Shown only when retracted AND hovered. Put custom peek content here. -->
                <Grid x:Name="PeekContent" Visibility="Collapsed">
                    <Image x:Name="PeekAlbumCover" HorizontalAlignment="Left"
                       Height="20" Width="20" Margin="8,0,0,0"
                       VerticalAlignment="Center">
                        <Image.Clip>
                            <RectangleGeometry Rect="0,0,20,20" RadiusX="5" RadiusY="5" />
                        </Image.Clip>
                    </Image>

                    <!-- What the sound is coming out of. The retracted island is otherwise just the
                         album art on one side and the privacy dots and waveform on the other, and
                         the stretch between them is where a device name belongs. Equal margins on
                         both sides centre the line in the island itself rather than in whatever
                         space the dots happen to leave, and the margin is the same whether or not
                         they are showing, so the line never shuffles sideways as they come and go.
                         It is trimmed rather than wrapped: this is a label on a 32px capsule, and
                         the start of a name is more use than none of it. -->
                    <TextBlock x:Name="PeekDevice"
                               Margin="32,0,32,0"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Foreground="#FFD6D6D8"
                               FontFamily="{StaticResource AppFont}"
                               FontSize="11"
                               Text="Connected Device" />

                    <!-- Right-aligned row: privacy dots, then the playing waveform. The dots sit to
                         the left of the waveform while it's shown, and slide all the way to the right
                         when it's hidden. Each item is a clipped "slot" whose width and opacity are
                         animated together, so shows/hides slide the row smoothly instead of snapping. -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Margin="0,0,10,0">
                        <Border x:Name="MicSlot" Width="0" VerticalAlignment="Center"
                                ClipToBounds="True" Visibility="Collapsed">
                            <Ellipse x:Name="MicDot" Width="8" Height="8" HorizontalAlignment="Left"
                                     Fill="#FFFF9F0A" />
                        </Border>
                        <Border x:Name="CameraSlot" Width="0" Padding="5,0,0,0" VerticalAlignment="Center"
                                ClipToBounds="True" Visibility="Collapsed">
                            <Ellipse x:Name="CameraDot" Width="8" Height="8" HorizontalAlignment="Left"
                                     Fill="#FF30D158" />
                        </Border>
                        <Border x:Name="WaveSlot" Width="0" Padding="6,0,0,0" VerticalAlignment="Center"
                                ClipToBounds="True" Visibility="Collapsed">
                            <local:GifImage x:Name="PeekWave"
                                            SourceUri="/Sprites/music_waveform.gif"
                                            Height="16" Width="16" HorizontalAlignment="Left"
                                            RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Shown while a toast notification is displayed: the sending app's icon on the
                     left, then the title and body text stacked in two equal halves. -->
                <Grid x:Name="NotificationContent" Visibility="Collapsed" Margin="14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Image x:Name="NotifIcon" Grid.Column="0" Width="44" Height="44"
                           VerticalAlignment="Center">
                        <Image.Clip>
                            <RectangleGeometry Rect="0,0,44,44" RadiusX="10" RadiusY="10" />
                        </Image.Clip>
                    </Image>

                    <Grid x:Name="NotifTextHost" Grid.Column="1" Margin="12,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="NotifTitle" Grid.Row="0"
                                   Foreground="White" FontFamily="{StaticResource AppFont}"
                                   FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="NotifBody" Grid.Row="1"
                                   Foreground="#FFBDBDBD" FontFamily="{StaticResource AppFont}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Grid>

                <!-- The name of whatever the pointer is resting on: the plate a tooltip would
                     have been. WPF draws it here rather than with a real tooltip because this
                     window is never activated, and the tooltip service will not open one without
                     an active window. It is the last thing in the island so that it can be read
                     over the board, and it takes no pointer input of its own so that it is never
                     in the way of the thing it is naming. -->
                <Canvas x:Name="HoverCanvas" IsHitTestVisible="False">
                    <Border x:Name="HoverName" Visibility="Collapsed"
                            Background="#F21C1C1E" CornerRadius="7"
                            BorderBrush="#33FFFFFF" BorderThickness="1" Padding="8,4">
                        <TextBlock x:Name="HoverNameText" FontFamily="{StaticResource AppFont}"
                                   FontSize="11" Foreground="#FFEDEDED" />
                    </Border>
                </Canvas>
            </Grid>
        </Border>
    </Grid>
</Window>