<Window x:Class="TopNotch.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TopNotch Setup"
        Icon="/Sprites/tray.ico"
        Width="760" Height="688"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#1E1E1E"
        FontFamily="{StaticResource AppFont}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#98989D" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="StyleCard" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Background="Transparent">
                            <Border x:Name="Card" Width="168" Height="86" CornerRadius="9"
                                    Background="#2C2C2E" BorderBrush="#3A3A3C" BorderThickness="2">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock x:Name="Caption" Text="{TemplateBinding Tag}"
                                       FontSize="11" Margin="0,7,0,0"
                                       HorizontalAlignment="Center" Foreground="#98989D" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="#3A3A3C" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="#2C2C2E" />
                                <Setter TargetName="Card" Property="BorderBrush" Value="#0A84FF" />
                                <Setter TargetName="Caption" Property="Foreground" Value="#0A84FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="22,9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fill" Background="#0A84FF" CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fill" Property="Background" Value="#2A95FF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Fill" Property="Background" Value="#0071E3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Switch" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent">
                            <Border Width="40" Height="24" CornerRadius="12" Background="#48484A" />
                            <Border x:Name="Fill" Width="40" Height="24" CornerRadius="12"
                                    Background="#0A84FF" Opacity="0" />
                            <Border x:Name="Knob" Width="18" Height="18" CornerRadius="9"
                                    Background="#FFFFFF"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="KnobShift" X="-8" />
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="KnobShift"
                                                             Storyboard.TargetProperty="X" To="8"
                                                             Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="Fill"
                                                             Storyboard.TargetProperty="Opacity" To="1"
                                                             Duration="0:0:0.16" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="KnobShift"
                                                             Storyboard.TargetProperty="X" To="-8"
                                                             Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="Fill"
                                                             Storyboard.TargetProperty="Opacity" To="0"
                                                             Duration="0:0:0.16" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="32,26,32,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Image Source="/Sprites/tray.ico" Width="44" Height="44"
                   VerticalAlignment="Top"
                   RenderOptions.BitmapScalingMode="HighQuality" />

            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Welcome to TopNotch" FontSize="24" FontWeight="SemiBold"
                           Foreground="#FFFFFF" />
                <TextBlock Text="An interactive widget optimized for productivity. Choose how it looks and behaves."
                           FontSize="12" Foreground="#98989D" TextWrapping="Wrap"
                           Margin="0,4,0,0" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Margin="32,18,32,0" Height="236"
                CornerRadius="12" ClipToBounds="True">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#32323A" Offset="0" />
                    <GradientStop Color="#1B1B1F" Offset="0.5" />
                    <GradientStop Color="#111113" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>

            <Grid>
                <Ellipse Width="560" Height="300" HorizontalAlignment="Center"
                         VerticalAlignment="Bottom" Margin="0,0,0,-150" IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#332A95FF" Offset="0" />
                            <GradientStop Color="#002A95FF" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <Border x:Name="PreviewIsland" Width="460" Height="142"
                        Background="Black" CornerRadius="0,0,20,20"
                        BorderBrush="#3A3A3D" BorderThickness="1"
                        HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Grid Margin="16,6,16,6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal"
                                    HorizontalAlignment="Center" Margin="0,1,0,4">
                            <StackPanel Margin="9,0">
                                <TextBlock Text="Home" FontSize="13" FontWeight="SemiBold"
                                           Foreground="#FFFFFF" HorizontalAlignment="Center" />
                                <Border Height="3" CornerRadius="1.5" Background="#FFFFFF"
                                        Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel Margin="9,0">
                                <TextBlock Text="Media" FontSize="13" FontWeight="SemiBold"
                                           Foreground="#9A9A9A" HorizontalAlignment="Center" />
                                <Border Height="3" CornerRadius="1.5" Background="#FFFFFF"
                                        Margin="0,3,0,0" Opacity="0" />
                            </StackPanel>
                            <StackPanel Margin="9,0">
                                <TextBlock Text="History" FontSize="13" FontWeight="SemiBold"
                                           Foreground="#9A9A9A" HorizontalAlignment="Center" />
                                <Border Height="3" CornerRadius="1.5" Background="#FFFFFF"
                                        Margin="0,3,0,0" Opacity="0" />
                            </StackPanel>
                            <StackPanel Margin="9,0">
                                <TextBlock Text="Launchpad" FontSize="13" FontWeight="SemiBold"
                                           Foreground="#9A9A9A" HorizontalAlignment="Center" />
                                <Border Height="3" CornerRadius="1.5" Background="#FFFFFF"
                                        Margin="0,3,0,0" Opacity="0" />
                            </StackPanel>
                            <StackPanel Margin="9,0">
                                <TextBlock Text="Clipboard" FontSize="13" FontWeight="SemiBold"
                                           Foreground="#9A9A9A" HorizontalAlignment="Center" />
                                <Border Height="3" CornerRadius="1.5" Background="#FFFFFF"
                                        Margin="0,3,0,0" Opacity="0" />
                            </StackPanel>
                        </StackPanel>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" Width="128" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="32" />
                                    <RowDefinition Height="6" />
                                    <RowDefinition Height="32" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Image Grid.Row="1" Grid.Column="0" Source="/Sprites/power.png"
                                       Width="24" Height="24" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                                <Image Grid.Row="1" Grid.Column="1" Source="/Sprites/restart.png"
                                       Width="24" Height="24" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                                <Image Grid.Row="1" Grid.Column="2" Source="/Sprites/link.png"
                                       Width="20" Height="20" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                                <Image Grid.Row="3" Grid.Column="0" Source="/Sprites/sleep.png"
                                       Width="21" Height="21" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                                <Image Grid.Row="3" Grid.Column="1" Source="/Sprites/lock.png"
                                       Width="22" Height="22" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                                <Image Grid.Row="3" Grid.Column="2" Source="/Sprites/picture.png"
                                       Width="27" Height="27" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Grid>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                        HorizontalAlignment="Center">
                                <TextBlock Foreground="White" FontSize="34" FontWeight="SemiBold"
                                           HorizontalAlignment="Left">
                                    <Run x:Name="PreviewTime" Text="--:--" /><Run x:Name="PreviewMeridiem" FontSize="17" />
                                </TextBlock>
                                <TextBlock x:Name="PreviewDate" FontSize="11" Foreground="#BDBDBD"
                                           Margin="3,2,0,0" HorizontalAlignment="Left" />
                            </StackPanel>

                            <Grid Grid.Column="2" Width="104" Height="76" VerticalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" VerticalAlignment="Center">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="CPU" FontSize="10" FontWeight="SemiBold"
                                               Foreground="White" HorizontalAlignment="Left" />
                                    <TextBlock Grid.Row="0" Text="24%" FontSize="9"
                                               Foreground="#BDBDBD" HorizontalAlignment="Right" />
                                    <Border Grid.Row="1" Height="3" CornerRadius="1.5"
                                            Background="#3D3D3D" Margin="0,3,0,0">
                                        <Border Width="25" Height="3" CornerRadius="1.5"
                                                Background="White" HorizontalAlignment="Left" />
                                    </Border>
                                </Grid>

                                <Grid Grid.Row="1" VerticalAlignment="Center">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Memory" FontSize="10" FontWeight="SemiBold"
                                               Foreground="White" HorizontalAlignment="Left" />
                                    <TextBlock Grid.Row="0" Text="61%" FontSize="9"
                                               Foreground="#BDBDBD" HorizontalAlignment="Right" />
                                    <Border Grid.Row="1" Height="3" CornerRadius="1.5"
                                            Background="#3D3D3D" Margin="0,3,0,0">
                                        <Border Width="63" Height="3" CornerRadius="1.5"
                                                Background="White" HorizontalAlignment="Left" />
                                    </Border>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Bottom" Margin="0,0,14,12" IsHitTestVisible="False"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="32,20,32,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="268" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,24,0">
                <TextBlock Text="Shape" Style="{StaticResource SectionHeader}" />

                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="CardNotch" GroupName="Shape" Tag="Attached"
                                 AutomationProperties.Name="Notch"
                                 Style="{StaticResource StyleCard}" Checked="Style_Checked">
                        <Grid Width="120" Height="62">
                            <Border Height="3" VerticalAlignment="Top" Background="#3A3A3C"
                                    Margin="8,0" CornerRadius="1.5" />
                            <Border Width="86" Height="34" Background="Black"
                                    CornerRadius="0,0,12,12" VerticalAlignment="Top"
                                    HorizontalAlignment="Center" />
                        </Grid>
                    </RadioButton>

                    <RadioButton x:Name="CardIsland" GroupName="Shape" Tag="Floating"
                                 AutomationProperties.Name="Dynamic Island"
                                 Style="{StaticResource StyleCard}" Margin="14,0,0,0"
                                 Checked="Style_Checked">
                        <Grid Width="120" Height="62">
                            <Border Height="3" VerticalAlignment="Top" Background="#3A3A3C"
                                    Margin="8,0" CornerRadius="1.5" />
                            <Border Width="86" Height="28" Background="Black"
                                    CornerRadius="14" VerticalAlignment="Top" Margin="0,9,0,0"
                                    HorizontalAlignment="Center" />
                        </Grid>
                    </RadioButton>
                </StackPanel>

                <TextBlock Text="Every change applies to the notch at the top of your screen right away, and is saved automatically."
                           FontSize="11" Foreground="#8E8E93" TextWrapping="Wrap"
                           Margin="2,16,12,0" />
            </StackPanel>

            <StackPanel Grid.Column="1">
                <TextBlock Text="Options" Style="{StaticResource SectionHeader}" />

                <Border Background="#2C2C2E" CornerRadius="9" Padding="14,9" Margin="0,0,0,8">
                    <Grid>
                        <StackPanel Margin="0,0,52,0">
                            <TextBlock Text="Outline" FontSize="13" Foreground="#FFFFFF" />
                            <TextBlock Text="A thin edge around the notch." FontSize="10"
                                       Foreground="#98989D" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                        <ToggleButton x:Name="OutlineSwitch" Style="{StaticResource Switch}"
                                      AutomationProperties.Name="Outline"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Checked="Outline_Changed" Unchecked="Outline_Changed" />
                    </Grid>
                </Border>

                <Border Background="#2C2C2E" CornerRadius="9" Padding="14,9" Margin="0,0,0,8">
                    <Grid>
                        <StackPanel Margin="0,0,52,0">
                            <TextBlock Text="24-hour clock" FontSize="13" Foreground="#FFFFFF" />
                            <TextBlock Text="Write the time as 17:42 instead of 5:42 PM." FontSize="10"
                                       Foreground="#98989D" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                        <ToggleButton x:Name="ClockSwitch" Style="{StaticResource Switch}"
                                      AutomationProperties.Name="24-hour clock"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Checked="Clock_Changed" Unchecked="Clock_Changed" />
                    </Grid>
                </Border>

                <Border Background="#2C2C2E" CornerRadius="9" Padding="14,9">
                    <Grid>
                        <StackPanel Margin="0,0,52,0">
                            <TextBlock Text="Hide in fullscreen" FontSize="13" Foreground="#FFFFFF" />
                            <TextBlock Text="Step aside while a game or video fills the screen." FontSize="10"
                                       Foreground="#98989D" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                        <ToggleButton x:Name="FullscreenSwitch" Style="{StaticResource Switch}"
                                      AutomationProperties.Name="Hide in fullscreen"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Checked="Fullscreen_Changed" Unchecked="Fullscreen_Changed" />
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3" Margin="32,18,32,24">
            <TextBlock Text="You can change all of this later from Settings, in the tray menu."
                       FontSize="11" Foreground="#8E8E93" VerticalAlignment="Center" />
            <Button x:Name="FinishButton" Content="Get Started" Style="{StaticResource AccentButton}"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    IsDefault="True" Click="Finish_Click" />
        </Grid>
    </Grid>
</Window>
